#define BLYNK_TEMPLATE_ID "TMPL6qx9EcB05"
#define BLYNK_TEMPLATE_NAME "Cửa RFID"
#define BLYNK_AUTH_TOKEN "xUgwUcmvOuELccgrYD7lIPurla-hQNI5"

#include <WiFi.h>
#include <WiFiClient.h>
#include <BlynkSimpleEsp32.h>
#include <SPI.h>
#include <MFRC522.h>
#include <ESP32Servo.h>

// WIFI
char ssid[] = "Hostpot";
char pass[] = "0123456788";

// ===== RFID =====
#define SS_PIN   5
#define RST_PIN  22
MFRC522 mfrc522(SS_PIN, RST_PIN);

// ===== SERVO =====
#define SERVO_PIN 14
Servo doorServo;

// ===== NÚT CỬA =====
#define BUTTON_DOOR 27

// ===== RELAY 1 (bóng đèn 1) =====
#define RELAY1_PIN 25
#define BUTTON_LED 32

// ===== RELAY 2 (bóng đèn 2) =====
#define RELAY2_PIN 26
#define BUTTON_LED2 33

// ===== UID HỢP LỆ =====
byte allowedUID[4] = {0xE7, 0x8B, 0x6B, 0x06};

// ===== TRẠNG THÁI =====
bool doorState = false;

// ==== RELAY 1 ====
bool relay1State = false;
int lastRelay1Reading = HIGH;
unsigned long lastDebounce = 0;
const unsigned long debounceDelay = 50;

// ==== RELAY 2 ====
bool relay2State = false;
int lastRelay2Reading = HIGH;
unsigned long lastDebounce2 = 0;

//==================== DOOR FUNCTIONS ====================

void openDoor() {
  Serial.println("=> DOOR OPEN");
  doorServo.write(90);
  doorState = true;
}

void closeDoor() {
  Serial.println("=> DOOR CLOSED");
  doorServo.write(0);
  doorState = false;
}

void toggleDoor() {
  if (doorState) closeDoor();
  else openDoor();

  Blynk.virtualWrite(V0, doorState ? 1 : 0);
}

//==================== BLYNK DOOR (V0) ====================
BLYNK_WRITE(V0) {
  toggleDoor();
}

//==================== BLYNK RELAY 1 (V1) ====================
BLYNK_WRITE(V1) {
  int value = param.asInt();
  relay1State = value;
  digitalWrite(RELAY1_PIN, relay1State ? LOW : HIGH); // ACTIVE LOW
}

//==================== BLYNK RELAY 2 (V2) ====================
BLYNK_WRITE(V2) {
  int value = param.asInt();
  relay2State = value;
  digitalWrite(RELAY2_PIN, relay2State ? LOW : HIGH); // ACTIVE LOW
}

//==================== RFID CHECK ====================

bool checkUID(byte *id) {
  for (byte i = 0; i < 4; i++) {
    if (id[i] != allowedUID[i]) return false;
  }
  return true;
}

//==================== SETUP ====================

void setup() {
  Serial.begin(115200);

  // RFID
  SPI.begin(18, 19, 23, SS_PIN);
  mfrc522.PCD_Init();

  // Servo
  doorServo.attach(SERVO_PIN, 500, 2400);
  closeDoor();

  // Buttons
  pinMode(BUTTON_DOOR, INPUT_PULLUP);
  pinMode(BUTTON_LED, INPUT_PULLUP);
  pinMode(BUTTON_LED2, INPUT_PULLUP);

  // Relays
  pinMode(RELAY1_PIN, OUTPUT);
  digitalWrite(RELAY1_PIN, HIGH); // tắt relay (active low)

  pinMode(RELAY2_PIN, OUTPUT);
  digitalWrite(RELAY2_PIN, HIGH); // tắt relay

  // WiFi + Blynk
  WiFi.begin(ssid, pass);
  Blynk.config(BLYNK_AUTH_TOKEN);

  Serial.println("System Ready: DOOR + RFID + RELAY1 + RELAY2");
}

//==================== LOOP ====================

void loop() {
  Blynk.run();

  // ======= BUTTON DOOR =======
  static bool lastButtonDoorState = HIGH;
  bool buttonDoorState = digitalRead(BUTTON_DOOR);
  if (buttonDoorState == LOW && lastButtonDoorState == HIGH) {
    Serial.println("Toggle Door by Physical Button");
    toggleDoor();
    delay(200);
  }
  lastButtonDoorState = buttonDoorState;

  // ======= BUTTON RELAY 1 =======
  int reading = digitalRead(BUTTON_LED);
  if (reading != lastRelay1Reading) lastDebounce = millis();

  if ((millis() - lastDebounce) > debounceDelay) {
    static int stableState = HIGH;
    if (reading != stableState) {
      stableState = reading;
      if (stableState == LOW) {
        relay1State = !relay1State;
        digitalWrite(RELAY1_PIN, relay1State ? LOW : HIGH);
        Blynk.virtualWrite(V1, relay1State ? 1 : 0);
      }
    }
  }
  lastRelay1Reading = reading;

  // ======= BUTTON RELAY 2 =======
  int reading2 = digitalRead(BUTTON_LED2);
  if (reading2 != lastRelay2Reading) lastDebounce2 = millis();

  if ((millis() - lastDebounce2) > debounceDelay) {
    static int stable2 = HIGH;
    if (reading2 != stable2) {
      stable2 = reading2;
      if (stable2 == LOW) {
        relay2State = !relay2State;
        digitalWrite(RELAY2_PIN, relay2State ? LOW : HIGH);
        Blynk.virtualWrite(V2, relay2State ? 1 : 0);

        Serial.print("Relay 2 -> ");
        Serial.println(relay2State ? "ON" : "OFF");
      }
    }
  }
  lastRelay2Reading = reading2;

  // ===== RFID =====
  if (!mfrc522.PICC_IsNewCardPresent()) return;
  if (!mfrc522.PICC_ReadCardSerial()) return;

  Serial.print("Card UID: ");
  for (byte i = 0; i < mfrc522.uid.size; i++) {
    Serial.print(mfrc522.uid.uidByte[i], HEX);
    Serial.print(" ");
  }
  Serial.println();

  if (checkUID(mfrc522.uid.uidByte)) {
    Serial.println("RFID Access Granted (Toggle)");
    toggleDoor();
  } else {
    Serial.println("RFID Access Denied");
  }

  mfrc522.PICC_HaltA();
  mfrc522.PCD_StopCrypto1();
  delay(250);
}

