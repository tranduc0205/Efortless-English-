// ==================== PIN CONFIG ====================
#define BUTTON_PIN 4
#define FIRE_PIN   35
#define SMOKE_PIN  34
#define RELAY_PIN  13

// ==================== MODULE LOGIC ====================
const bool RELAY_ACTIVE_LOW = false;   // đổi theo loại relay của bạn
const bool SENSOR_ACTIVE_LOW = true;   // D0 = LOW khi có lửa/khói

// ==================== STATE ====================
bool alarmActive = false;       // còi đang chạy 4 giây?
unsigned long alarmStart = 0;

// ======================================================
void setRelay(bool on) {
  digitalWrite(RELAY_PIN,
      RELAY_ACTIVE_LOW ? (!on ? HIGH : LOW)
                       : (on ? HIGH : LOW));
}

// ======================================================
void startAlarm4s() {
  alarmActive = true;
  alarmStart = millis();
  setRelay(true);
  Serial.println(">>> ALARM START (4s)");
}

// ======================================================
void setup() {
  Serial.begin(115200);

  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(FIRE_PIN,   INPUT);
  pinMode(SMOKE_PIN,  INPUT);
  pinMode(RELAY_PIN,  OUTPUT);

  setRelay(false);
  Serial.println("=== SYSTEM READY (4s ALARM MODE) ===");
}

// ======================================================
void loop() {
  unsigned long now = millis();

  // ==================== TỰ TẮT SAU 4 GIÂY ====================
  if (alarmActive && (now - alarmStart >= 4000)) {
    alarmActive = false;
    setRelay(false);
    Serial.println("<<< ALARM STOP (timeout 4s)");
  }

  // nếu đang kêu thì bỏ qua mọi thứ khác
  if (alarmActive) return;

  // ==================== XỬ LÝ NÚT ====================
  bool pressed = (digitalRead(BUTTON_PIN) == LOW);
  static unsigned long lastBtn = 0;

  if (pressed && now - lastBtn > 300) {   // debounce
    lastBtn = now;
    startAlarm4s();
    return;   // kết thúc vì đã bật còi
  }

  // ==================== ĐỌC CẢM BIẾN ====================
  bool fire  = SENSOR_ACTIVE_LOW ? (digitalRead(FIRE_PIN)  == LOW)
                                 : (digitalRead(FIRE_PIN)  == HIGH);

  bool smoke = SENSOR_ACTIVE_LOW ? (digitalRead(SMOKE_PIN) == LOW)
                                 : (digitalRead(SMOKE_PIN) == HIGH);

  // ==================== NẾU LỬA/ KHÓI ====================
  if (fire || smoke) {
    Serial.println("!!! FIRE/SMOKE DETECTED -> alarm 4s");
    startAlarm4s();
  }
}
